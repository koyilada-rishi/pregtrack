# No config.js — the API URL is intentionally committed in js/defaults.js
# instead (it's not actually a secret once deployed — see README's security
# notes), and the PIN lives only in localStorage, entered via the first-run
# screen, never in any file. Kept here defensively in case a local
# experiment recreates a config.js-style file.
js/config.js
js/config.local.js

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*~
.vscode/
.idea/
.claude/

# Node (only used for local dev tooling, no build step for the app itself)
node_modules/
npm-debug.log*

# Local env files, just in case
.env
.env.*

# MamaCare design mockups (design/1-today.html etc.) — reference only for
# the UI restyle, never committed; the mockups themselves may not be ours
# to publish, and only their design tokens get translated into css/tokens.css.
design/
